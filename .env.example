# v5 trading engine , environment (names only; real values live in the server's environment store)
# Never commit a real key. Never put the notification topic in a file that is committed.

# Which account this process uses. The compose file sets these two per service.
# TRADING_MODE is paper or live; ALPACA_KEY_PREFIX is PAPER or LIVE and must match it.
# (No comments after a value: everything after the equals sign is taken as the value.)
TRADING_MODE=paper
ALPACA_KEY_PREFIX=PAPER

# Alpaca keys (Trading API). Paper and live are different key pairs.
ALPACA_PAPER_API_KEY=your-paper-key
ALPACA_PAPER_SECRET_KEY=your-paper-secret
ALPACA_LIVE_API_KEY=your-live-key
ALPACA_LIVE_SECRET_KEY=your-live-secret

# Owner notifications (ntfy). The topic is a secret: whoever knows it can read the messages.
NTFY_TOPIC=your-private-topic
# Optional: a separate topic for the practice (paper) account, so its messages stay off the owner's phone.
# NTFY_TOPIC_PAPER=your-practice-topic
# NTFY_BASE_URL=https://ntfy.sh

# The real-money service sends orders ONLY when this is set to true (1, true, yes, on).
# Leave it out for a dry run: the engine decides and reports, but sends nothing.
# LIVE_TRADING_ENABLED=true

# Risk package: moderate | high | very_high (default high).
# STRATEGY_PACKAGE=high

# Symbols the owner holds himself in the same account (comma separated). The engine never trades them,
# never treats them as a foreign asset, and sizes its own orders on the equity that is left without them.
# V5_OWNER_SYMBOLS=ANT

# Optional rail overrides (fractions between 0 and 1). Defaults come from the package.
# V5_ALERT_DD=0.37
# V5_BREAKER_DAY=0.15
# V5_FLOOR_DD=0.60

# Optional: where the state folders live (default: the application folder).
# STATE_VOLUME_PATH=/app
